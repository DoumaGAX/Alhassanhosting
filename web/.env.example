# Public connection values are optional until you connect a real hosting node.
# Do not put passwords, service-role keys, or other secrets in VITE_* variables.
VITE_PUBLIC_JAVA_HOST=
VITE_PUBLIC_JAVA_PORT=25565
VITE_PUBLIC_BEDROCK_HOST=
VITE_PUBLIC_BEDROCK_PORT=19132

# These are server-side Netlify variables; set them in Netlify, not in VITE_* browser variables.
# POCKETMC_BASE_URL=https://your-current-tunnel.example
# POCKETMC_USERNAME=restricted-pocketmc-subuser
# POCKETMC_PASSWORD=use-a-unique-strong-password
# POCKETMC_OWNER_USER_ID=your-supabase-auth-user-uuid
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key
